# AMC Report Generator Configuration
# Copy this file to .env and customize the values
# All settings are prefixed with AMC_ when used as environment variables

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Directory containing your AMC project folders
AMC_PROJECTS_DIR=/path/to/Projets-QCM

# Claude AI API key (optional, enables the AI commentary)
# Alternative names also supported: CLAUDE_API_KEY, ANTHROPIC_API_KEY
# Without a key, the report is built without the AI commentary.
# AMC_CLAUDE_API_KEY=your-api-key-here

# ============================================================================
# EXAM ANALYSIS SETTINGS
# ============================================================================

# Minimum students required for discrimination analysis (default: 99)
# AMC_STUDENT_THRESHOLD=99

# ============================================================================
# COMPANY BRANDING
# ============================================================================

# Your organization name (appears in reports)
# AMC_COMPANY_NAME=My University

# Your organization website (appears in reports)
# AMC_COMPANY_URL=https://www.example.edu

# ============================================================================
# AI ANALYSIS SETTINGS
# ============================================================================

# Enable/disable Claude AI statistical analysis (default: true)
# AMC_ENABLE_AI_ANALYSIS=true

# ============================================================================
# EXAM REPOSITORY SETTINGS (Optional)
# ============================================================================
# Track exam metrics over time for comparative analysis
# Supported backends: 'airtable' or 'none' to disable (default: none)
# AMC_REPOSITORY_BACKEND=none

# --- Airtable Configuration ---
# If using Airtable as your repository backend:
# 1. Create a free account at https://airtable.com
# 2. Create a new base (e.g., "AMC Exam Repository")
# 3. Create a Personal Access Token with these scopes:
#    - data.records:read (to read existing records)
#    - data.records:write (to save exam metrics)
#    - schema.bases:read (to check if table/fields exist)
#    - schema.bases:write (to auto-create table/fields) - REQUIRED for auto-setup
# 4. Grant the token access to your base
# 5. Get your Base ID: Open base → Help → API docs → "The ID of this base is..."
#
# Note: The table and fields will be auto-created on first run if they don't exist!

# Airtable API key (also accepts AIRTABLE_API_KEY without AMC_ prefix)
# AMC_AIRTABLE_API_KEY=your-airtable-api-key-here

# Airtable Base ID (looks like app123456789abcd)
# AMC_AIRTABLE_BASE_ID=your-base-id-here

# Airtable table name (default: Exams)
# AMC_AIRTABLE_TABLE_NAME=Exams

# ============================================================================
# LOGGING SETTINGS
# ============================================================================

# Console log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# AMC_LOG_LEVEL=INFO
